{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NoteforJun",
  "version": "1.0.5",
  "identifier": "com.noteforjun.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "endpoints": [
        "https://github.com/O6west/NoteforJun/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDk2RkNDNjk2MTAwM0U2RDkKUldUWjVnTVFsc2I4bG1TWUxkSWREUi9JSXBSbldNdHRMOHlzK2g2Z1YrVFZCOGx5M2RJdmRUTU0K",
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
